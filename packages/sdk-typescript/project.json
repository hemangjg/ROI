{
  "name": "sdk-typescript",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/sdk-typescript/src",
  "tags": ["type:lib", "scope:sdk"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["sdk-core:build"],
      "options": {
        "command": "pnpm build",
        "cwd": "packages/sdk-typescript"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "packages/sdk-typescript"
      }
    }
  }
}
