{
  "name": "proto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/proto",
  "tags": ["type:lib", "scope:proto"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["go build ./...", "pnpm exec tsc -p tsconfig.json --noEmit"],
        "parallel": false,
        "cwd": "{workspaceRoot}/packages/proto"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./...",
        "cwd": "packages/proto"
      }
    }
  }
}
