# AI FinOps — local development environment
# Copy to .env and adjust as needed.

# --- Host-native development (go run ./cmd/server) ---
# PostgreSQL
DATABASE_URL=postgres://finops:finops@localhost:5432/finops?sslmode=disable

# ClickHouse
CLICKHOUSE_URL=clickhouse://localhost:9000/finops

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Temporal
TEMPORAL_HOST=localhost:7233

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=finops

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-finops

# JWT (local dev — generate via scripts/gen-local-certs.sh in later workstreams)
JWT_PRIVATE_KEY_PATH=./secrets/jwt.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt.pub.pem

# API
API_BASE_URL=http://localhost:8888

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8888/v1
NEXT_PUBLIC_USE_MOCK_API=false

# --- Docker Compose (service DNS names) ---
